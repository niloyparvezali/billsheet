rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    match /users/{id} {
      allow create: if ownsNew();
      allow read: if ownsExisting();
      allow update: if ownsExisting() && ownerUnchanged();
      allow delete: if ownsExisting();
    }

    match /categories/{id} {
      allow create: if ownsNew();
      allow read: if ownsExisting();
      allow update: if ownsExisting() && ownerUnchanged();
      allow delete: if ownsExisting();
    }

    match /payments/{id} {
      allow create: if ownsNew();
      allow read: if ownsExisting();
      allow update: if ownsExisting() && ownerUnchanged();
      allow delete: if ownsExisting();
    }

    match /settings/{id} {
      allow read, write: if signedIn() && id == request.auth.uid;
    }

    match /authAccounts/{id} {
      allow read, write: if signedIn() && id == request.auth.uid;
    }
  }
}